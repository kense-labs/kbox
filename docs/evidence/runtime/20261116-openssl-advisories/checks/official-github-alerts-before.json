it. On OpenSSL 1.1.x, X25519, X448, DH and HKDF-extract  ignore the incoming `*keylen`, unconditionally writing the full shared secret (32/56/prime-size bytes). A caller passing a short slice gets a heap/stack overflow from safe code. OpenSSL 3.x providers do check, so this only impacts older OpenSSL.","severity":"high","identifiers":[{"value":"GHSA-pqf5-4pqq-29f5","type":"GHSA"},{"value":"CVE-2026-41676","type":"CVE"}],"references":[{"url":"https://github.com/rust-openssl/rust-openssl/security/advisories/GHSA-pqf5-4pqq-29f5"},{"url":"https://github.com/rust-openssl/rust-openssl/pull/2606"},{"url":"https://github.com/rust-openssl/rust-openssl/commit/09b425e5f59a2466d806e71a83a9a449c914c596"},{"url":"https://github.com/rust-openssl/rust-openssl/releases/tag/openssl-v0.10.78"},{"url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41676"},{"url":"https://github.com/advisories/GHSA-pqf5-4pqq-29f5"}],"published_at":"2026-04-22T21:22:00Z","updated_at":"2026-04-27T16:42:06Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"rust","name":"openssl"},"severity":"high","vulnerable_version_range":">= 0.9.27, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:U","score":7.2}},"epss":{"percentage":0.00285,"percentile":0.20805},"cvss":{"vector_string":null,"score":0.0},"cwes":[{"cwe_id":"CWE-131","name":"Incorrect Calculation of Buffer Size"},{"cwe_id":"CWE-787","name":"Out-of-bounds Write"}],"classification":"general"},"security_vulnerability":{"package":{"ecosystem":"rust","name":"openssl"},"severity":"high","vulnerable_version_range":">= 0.9.27, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}},"url":"https://api.github.com/repos/kense-labs/kbox/dependabot/alerts/6","html_url":"https://github.com/kense-labs/kbox/security/dependabot/6","created_at":"2026-11-05T03:18:33Z","updated_at":"2026-11-05T03:18:33Z","dismissal_request":null,"assignees":[],"reachability":{"verdict":"disabled"},"dismissed_at":null,"dismissed_by":null,"dismissed_reason":null,"dismissed_comment":null,"fixed_at":null,"auto_dismissed_at":null},{"number":5,"state":"open","dependency":{"package":{"ecosystem":"rust","name":"openssl"},"manifest_path":"Cargo.lock","version_requirement":"= 0.10.73","scope":"runtime","relationship":"unknown"},"security_advisory":{"ghsa_id":"GHSA-xmgf-hq76-4vx2","cve_id":"CVE-2026-41677","summary":"rust-opennssl has an Out-of-bounds read in PEM password callback when returning an oversized length","description":"The `*_from_pem_callback` APIs did not validate the length returned by the user's callback. A password callback that returns a value larger than the buffer it was given can cause some versions of OpenSSL to over-read this buffer. OpenSSL 3.x is not affected by this.","severity":"low","identifiers":[{"value":"GHSA-xmgf-hq76-4vx2","type":"GHSA"},{"value":"CVE-2026-41677","type":"CVE"}],"references":[{"url":"https://github.com/rust-openssl/rust-openssl/security/advisories/GHSA-xmgf-hq76-4vx2"},{"url":"https://github.com/rust-openssl/rust-openssl/pull/2605"},{"url":"https://github.com/rust-openssl/rust-openssl/commit/5af6895c907773699f37f583f409b862284062b1"},{"url":"https://github.com/rust-openssl/rust-openssl/releases/tag/openssl-v0.10.78"},{"url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41677"},{"url":"https://github.com/advisories/GHSA-xmgf-hq76-4vx2"}],"published_at":"2026-04-22T21:20:04Z","updated_at":"2026-04-27T16:42:01Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"rust","name":"openssl"},"severity":"low","vulnerable_version_range":">= 0.9.0, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:N/VA:L/SC:N/SI:N/SA:N/E:U","score":1.7}},"epss":{"percentage":0.00294,"percentile":0.21785},"cvss":{"vector_string":null,"score":0.0},"cwes":[{"cwe_id":"CWE-125","name":"Out-of-bounds Read"},{"cwe_id":"CWE-1284","name":"Improper Validation of Specified Quantity in Input"}],"classification":"general"},"security_vulnerability":{"package":{"ecosystem":"rust","name":"openssl"},"severity":"low","vulnerable_version_range":">= 0.9.0, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}},"url":"https://api.github.com/repos/kense-labs/kbox/dependabot/alerts/5","html_url":"https://github.com/kense-labs/kbox/security/dependabot/5","created_at":"2026-11-05T03:18:33Z","updated_at":"2026-11-05T03:18:33Z","dismissal_request":null,"assignees":[],"reachability":{"verdict":"disabled"},"dismissed_at":null,"dismissed_by":null,"dismissed_reason":null,"dismissed_comment":null,"fixed_at":null,"auto_dismissed_at":null},{"number":4,"state":"open","dependency":{"package":{"ecosystem":"rust","name":"openssl"},"manifest_path":"Cargo.lock","version_requirement":"= 0.10.73","scope":"runtime","relationship":"unknown"},"security_advisory":{"ghsa_id":"GHSA-8c75-8mhr-p7r9","cve_id":"CVE-2026-41678","summary":"rust-openssl has incorrect bounds assertion in aes key wrap","description":"### Summary\n``aes::unwrap_key()`` has an incorrect bounds assertion on the out buffer size, which can lead to out-of-bounds write.\n\n### Details\n``aes::unwrap_key()`` contains an incorrect assertion: it checks that `out.len() + 8 <= in_.len()`, but this condition is reversed. The intended invariant is `out.len() >= in_.len() - 8`, ensuring the output buffer is large enough.\n\nBecause of the inverted check, the function only accepts buffers at or below the minimum required size and rejects larger ones. If a smaller buffer is provided the function will write past the end of `out` by `in_.len() - 8 - out.len()` bytes, causing an out-of-bounds write from a safe public function.\n\n### Impact\nVulnerable applications using AES keywrap and allowing attacker controlled buffer sizes could have an attacker trigger an out-of-bounds write.","severity":"high","identifiers":[{"value":"GHSA-8c75-8mhr-p7r9","type":"GHSA"},{"value":"CVE-2026-41678","type":"CVE"}],"references":[{"url":"https://github.com/rust-openssl/rust-openssl/security/advisories/GHSA-8c75-8mhr-p7r9"},{"url":"https://github.com/rust-openssl/rust-openssl/pull/2604"},{"url":"https://github.com/rust-openssl/rust-openssl/commit/718d07ff8ff7be417d5b7a6a0047f1607520b3b6"},{"url":"https://github.com/rust-openssl/rust-openssl/releases/tag/openssl-v0.10.78"},{"url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41678"},{"url":"https://github.com/advisories/GHSA-8c75-8mhr-p7r9"}],"published_at":"2026-04-22T21:17:32Z","updated_at":"2026-04-27T16:41:56Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"rust","name":"openssl"},"severity":"high","vulnerable_version_range":">= 0.10.24, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:U","score":7.2}},"epss":{"percentage":0.00251,"percentile":0.16511},"cvss":{"vector_string":null,"score":0.0},"cwes":[{"cwe_id":"CWE-787","name":"Out-of-bounds Write"}],"classification":"general"},"security_vulnerability":{"package":{"ecosystem":"rust","name":"openssl"},"severity":"high","vulnerable_version_range":">= 0.10.24, < 0.10.78","first_patched_version":{"identifier":"0.10.78"}},"url":"https://api.github.com/repos/kense-labs/kbox/dependabot/alerts/4","html_url":"https://github.com/kense-labs/kbox/security/dependabot/4","created_at":"2026-11-05T03:18:33Z","updated_at":"2026-11-05T03:18:33Z","dismissal_request":null,"assignees":[],"reachability":{"verdict":"disabled"},"dismissed_at":null,"dismissed_by":null,"dismissed_reason":null,"dismissed_comment":null,"fixed_at":null,"auto_dismissed_at":null},{"number":3,"state":"open","dependency":{"package":{"ecosystem":"rust","name":"openssl"},"manifest_path":"Cargo.lo